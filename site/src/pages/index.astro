
---
// #---
// IMPORTS AND IMAGE CONFIGURATION
// #---

import MainLayout from '../layouts/MainLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const heroImage = `${base}/images/asares-banner.png`;
---

<MainLayout title="Home">

  <!-- #---
       HERO SECTION
       Slim cinematic homepage banner
       #--- -->

  <section class="hero">

    <!-- #---
         HERO ARTWORK
         Full width with reduced vertical height
         #--- -->

    <div class="hero-visual">
      <img
        class="hero-art"
        src={heroImage}
        alt="Asares wielding iridescent magic"
        width="1914"
        height="822"
        fetchpriority="high"
      />
    </div>

    <!-- #---
         HERO CONTENT
         Website title, tagline, and button
         #--- -->

    <div class="hero-content">

      <span class="eyebrow">
        THE OFFICIAL FANTASY UNIVERSE
      </span>

      <h1>ARALICIA</h1>

      <p>Every story begins somewhere.</p>

      <a class="hero-button" href="#explore">
        EXPLORE ARALICIA
      </a>

    </div>

  </section>


  <!-- #---
       EXPLORE SECTION
       Main website categories
       #--- -->

  <section class="explore" id="explore">

    <span class="section-label">
      DISCOVER THE UNIVERSE
    </span>

    <h2>Explore Aralicia</h2>

    <!-- #---
         EXPLORE CARDS
         Five main content categories
         #--- -->

    <div class="explore-grid">

      <article>
        <h3>The Novel</h3>
        <p>
          Read chapters, volumes, and story arcs.
        </p>
      </article>

      <article>
        <h3>Characters</h3>
        <p>
          Discover Asares, Kaleid, Axel,
          Thalia, and the cast.
        </p>
      </article>

      <article>
        <h3>World Guide</h3>
        <p>
          Explore kingdoms, cultures,
          creatures, and magic.
        </p>
      </article>

      <article>
        <h3>Lore Archives</h3>
        <p>
          Uncover history, legends,
          and ancient mysteries.
        </p>
      </article>

      <article>
        <h3>Multimedia</h3>
        <p>
          Browse illustrations and
          character artwork.
        </p>
      </article>

    </div>

  </section>

</MainLayout>


<style>

  /* #---
     HERO CONTAINER
     Main cinematic banner
     #--- */

  .hero {
    position: relative;
    width: 100%;
    background: #09090d;
    overflow: hidden;
  }


  /* #---
     HERO VISUAL
     Slimmer desktop banner proportions
     #--- */

  .hero-visual {
    position: relative;
    width: 100%;
    aspect-ratio: 2.65 / 1;
    overflow: hidden;
    background: #09090d;
  }


  /* #---
     HERO ARTWORK
     Full width with controlled vertical cropping
     Lower artwork prioritized for arm and tattoo
     #--- */

  .hero-art {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;

    object-fit: cover;
    object-position: center 65%;
  }


  /* #---
     CINEMATIC OVERLAY
     Subtle shading behind desktop text
     #--- */

  .hero-visual::after {
    content: "";
    position: absolute;
    inset: 0;

    background: linear-gradient(
      90deg,
      rgba(5, 5, 10, 0.52) 0%,
      rgba(5, 5, 10, 0.20) 28%,
      transparent 55%
    );

    pointer-events: none;
  }


  /* #---
     HERO TEXT CONTAINER
     Upper left placement
     #--- */

  .hero-content {
    position: absolute;
    z-index: 2;

    top: 12%;
    left: 4%;

    width: min(450px, 40%);
    padding: 18px;

    color: white;
  }


  /* #---
     SMALL SECTION LABELS
     Iridescent accent text
     #--- */

  .eyebrow,
  .section-label {
    font-size: 11px;
    letter-spacing: 0.2em;
    font-weight: 800;
    color: #d7baf0;
  }


  /* #---
     MAIN ARALICIA TITLE
     Cinematic homepage lettering
     #--- */

  h1 {
    font-size: clamp(40px, 4.5vw, 76px);
    letter-spacing: 0.06em;

    margin: 16px 0 10px;

    color: white;
    line-height: 1.1;
  }


  /* #---
     HERO TAGLINE
     Every story begins somewhere
     #--- */

  .hero-content p {
    font-family: Georgia, serif;

    font-size: clamp(17px, 2vw, 29px);
    font-style: italic;

    color: #f0eaf5;
    line-height: 1.4;

    margin: 0;
  }


  /* #---
     HERO BUTTON
     Explore Aralicia
     #--- */

  .hero-button {
    display: inline-block;

    margin-top: 28px;
    padding: 15px 24px;

    border: 1px solid #c8b0e5;
    background: rgba(0, 0, 0, 0.55);

    font-size: 11px;
    letter-spacing: 0.08em;
    font-weight: 800;

    color: white;
    text-decoration: none;

    transition:
      background 0.25s ease,
      border-color 0.25s ease;
  }

  .hero-button:hover {
    background: rgba(170, 145, 210, 0.3);
    border-color: #e2caff;
  }


  /* #---
     EXPLORE SECTION
     Content below the hero banner
     #--- */

  .explore {
    max-width: 1200px;
    margin: auto;
    padding: 85px 24px;
  }


  /* #---
     EXPLORE HEADING
     Section title typography
     #--- */

  h2 {
    font-family: Georgia, serif;
    font-size: clamp(36px, 5vw, 56px);

    margin: 15px 0 36px;
  }


  /* #---
     EXPLORE GRID
     Three columns on desktop
     #--- */

  .explore-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }


  /* #---
     EXPLORE CARDS
     Individual content categories
     #--- */

  article {
    border: 1px solid #36323f;
    background: #141319;

    padding: 30px;
    min-height: 165px;

    transition:
      border-color 0.25s ease,
      background 0.25s ease;
  }

  article:hover {
    border-color: #a98bc9;
    background: #1b1823;
  }

  article h3 {
    font-size: 21px;
    margin: 0 0 12px;
    color: white;
  }

  article p {
    color: #bcb7c6;
    line-height: 1.7;
    margin: 0;
  }


  /* #---
     TABLET RESPONSIVE DESIGN
     Adjustments for medium screens
     #--- */

  @media (max-width: 900px) {

    .hero-content {
      top: 8%;
      left: 3%;
      width: 45%;
      padding: 12px;
    }

    h1 {
      font-size: clamp(34px, 5vw, 55px);
    }

    .hero-content p {
      font-size: clamp(16px, 2vw, 22px);
    }

    .hero-button {
      padding: 12px 16px;
      margin-top: 15px;
    }

    .explore-grid {
      grid-template-columns: repeat(2, 1fr);
    }

  }


  /* #---
     MOBILE RESPONSIVE DESIGN
     Preserve complete artwork on phones
     #--- */

  @media (max-width: 700px) {

    /* #---
       MOBILE HERO ARTWORK
       Full original image without cropping
       #--- */

    .hero-visual {
      width: 100%;
      aspect-ratio: 1914 / 822;
    }

    .hero-art {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center;
    }

    .hero-visual::after {
      display: none;
    }


    /* #---
       MOBILE HERO CONTENT
       Text displayed beneath the illustration
       #--- */

    .hero-content {
      position: relative;

      top: auto;
      left: auto;

      width: 100%;
      max-width: none;

      padding: 32px 24px 45px;

      background: #09090d;
    }


    /* #---
       MOBILE ARALICIA TITLE
       Responsive title size
       #--- */

    h1 {
      font-size: clamp(42px, 11vw, 65px);
      letter-spacing: 0.05em;
      overflow-wrap: anywhere;
    }


    /* #---
       MOBILE TAGLINE
       Improved readability
       #--- */

    .hero-content p {
      font-size: clamp(20px, 5vw, 26px);
    }


    /* #---
       MOBILE HERO BUTTON
       Comfortable touch target
       #--- */

    .hero-button {
      margin-top: 24px;
      padding: 15px 24px;
      font-size: 12px;
    }


    /* #---
       MOBILE EXPLORE SECTION
       Reduced padding
       #--- */

    .explore {
      padding: 65px 20px;
    }


    /* #---
       MOBILE EXPLORE CARDS
       Single column layout
       #--- */

    .explore-grid {
      grid-template-columns: 1fr;
    }

  }

</style>
