
---
// #---
// IMPORTS AND IMAGE CONFIGURATION
// #---

import MainLayout from '../layouts/MainLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const heroImage = `${base}/images/asares-hero.png`;
---

<MainLayout title="Home">

  <!-- #---
       HERO SECTION
       Main homepage artwork featuring Asares
       #--- -->

  <section class="hero">

    <!-- #---
         HERO ARTWORK
         Full width with original proportions
         #--- -->

    <div class="hero-visual">

      <img
        class="hero-art"
        src={heroImage}
        alt="Asares wielding iridescent magic"
        width="1484"
        height="1060"
        fetchpriority="high"
      />

    </div>

    <!-- #---
         HERO TEXT
         Website title, tagline, and main button
         #--- -->

    <div class="hero-content">

      <span class="eyebrow">
        THE OFFICIAL FANTASY UNIVERSE
      </span>

      <h1>ARALICIA</h1>

      <p>Every story begins somewhere.</p>

      <a class="hero-button" href="#explore">
        EXPLORE ARALICIA
      </a>

    </div>

  </section>


  <!-- #---
       EXPLORE SECTION
       Main website content categories
       #--- -->

  <section class="explore" id="explore">

    <span class="section-label">
      DISCOVER THE UNIVERSE
    </span>

    <h2>Explore Aralicia</h2>

    <!-- #---
         EXPLORE CARDS
         Novel, characters, world, lore, multimedia
         #--- -->

    <div class="explore-grid">

      <article>
        <h3>The Novel</h3>
        <p>
          Read chapters, volumes, and story arcs.
        </p>
      </article>

      <article>
        <h3>Characters</h3>
        <p>
          Discover Asares, Kaleid, Axel,
          Thalia, and the cast.
        </p>
      </article>

      <article>
        <h3>World Guide</h3>
        <p>
          Explore kingdoms, cultures,
          creatures, and magic.
        </p>
      </article>

      <article>
        <h3>Lore Archives</h3>
        <p>
          Uncover history, legends,
          and ancient mysteries.
        </p>
      </article>

      <article>
        <h3>Multimedia</h3>
        <p>
          Browse illustrations and
          character artwork.
        </p>
      </article>

    </div>

  </section>

</MainLayout>


<style>

  /* #---
     HERO CONTAINER
     Controls the full width banner
     #--- */

  .hero {
    position: relative;
    width: 100%;
    background: #09090d;
    overflow: hidden;
  }


  /* #---
     HERO VISUAL
     Natural image height prevents cropping
     #--- */

  .hero-visual {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
    background: #09090d;
  }


  /* #---
     HERO ARTWORK
     Full width image with no zoom or crop
     #--- */

  .hero-art {
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
    object-fit: contain;
    object-position: center center;
  }


  /* #---
     HERO TEXT CONTAINER
     Positioned over the desktop artwork
     #--- */

  .hero-content {
    position: absolute;
    z-index: 2;

    top: 28%;
    left: 5%;

    transform: translateY(-50%);

    max-width: 700px;
    padding: 28px;

    background: linear-gradient(
      90deg,
      rgba(5, 5, 10, 0.70) 0%,
      rgba(5, 5, 10, 0.35) 65%,
      rgba(5, 5, 10, 0) 100%
    );
  }


  /* #---
     SMALL HEADINGS
     Iridescent accent typography
     #--- */

  .eyebrow,
  .section-label {
    font-size: 11px;
    letter-spacing: 0.2em;
    font-weight: 800;
    color: #d7baf0;
  }


  /* #---
     MAIN ARALICIA TITLE
     Cinematic homepage lettering
     #--- */

  h1 {
    font-size: clamp(52px, 7vw, 105px);
    letter-spacing: 0.075em;

    margin: 20px 0 8px;

    color: white;
    line-height: 1.1;
  }


  /* #---
     HERO TAGLINE
     Every story begins somewhere
     #--- */

  .hero-content p {
    font-family: Georgia, serif;

    font-size: clamp(22px, 2.7vw, 34px);
    font-style: italic;

    color: #f0eaf5;
    line-height: 1.5;
  }


  /* #---
     HERO BUTTON
     Explore Aralicia action
     #--- */

  .hero-button {
    display: inline-block;

    margin-top: 30px;
    padding: 17px 28px;

    border: 1px solid #c8b0e5;
    background: rgba(0, 0, 0, 0.5);

    font-size: 12px;
    letter-spacing: 0.08em;
    font-weight: 800;

    color: white;
    text-decoration: none;

    transition:
      background 0.25s ease,
      border-color 0.25s ease;
  }

  .hero-button:hover {
    background: rgba(170, 145, 210, 0.25);
    border-color: #e2caff;
  }


  /* #---
     EXPLORE SECTION
     Main content below the hero
     #--- */

  .explore {
    max-width: 1200px;
    margin: auto;
    padding: 100px 24px;
  }


  /* #---
     EXPLORE TITLE
     Section heading typography
     #--- */

  h2 {
    font-family: Georgia, serif;
    font-size: clamp(36px, 5vw, 56px);

    margin: 15px 0 36px;
  }


  /* #---
     EXPLORE GRID
     Desktop content layout
     #--- */

  .explore-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }


  /* #---
     EXPLORE CARDS
     Individual content categories
     #--- */

  article {
    border: 1px solid #36323f;
    background: #141319;

    padding: 30px;
    min-height: 165px;

    transition:
      border-color 0.25s ease,
      background 0.25s ease;
  }

  article:hover {
    border-color: #a98bc9;
    background: #1b1823;
  }

  article h3 {
    font-size: 21px;
    margin: 0 0 12px;
    color: white;
  }

  article p {
    color: #bcb7c6;
    line-height: 1.7;
    margin: 0;
  }


  /* #---
     TABLET RESPONSIVE STYLES
     Layout adjustments for medium screens
     #--- */

  @media (max-width: 1000px) {

    .hero-content {
      top: 30%;
      left: 3%;

      max-width: 600px;
      padding: 20px;
    }

    h1 {
      font-size: clamp(46px, 7vw, 80px);
    }

    .explore-grid {
      grid-template-columns: repeat(2, 1fr);
    }

  }


  /* #---
     MOBILE RESPONSIVE STYLES
     Full artwork visible on iPhone
     Text displayed beneath the image
     #--- */

  @media (max-width: 700px) {

    /* #---
       MOBILE HERO ARTWORK
       Preserve full illustration
       #--- */

    .hero-visual {
      width: 100%;
      height: auto;
      overflow: visible;
    }

    .hero-art {
      display: block;

      width: 100%;
      height: auto;

      object-fit: contain;
      object-position: center;
    }


    /* #---
       MOBILE HERO TEXT
       Position beneath artwork
       #--- */

    .hero-content {
      position: relative;

      top: auto;
      left: auto;

      transform: none;

      width: 100%;
      max-width: none;

      padding: 35px 24px 48px;

      background: #09090d;
    }


    /* #---
       MOBILE WEBSITE TITLE
       Smaller text for narrow screens
       #--- */

    h1 {
      font-size: clamp(42px, 11vw, 68px);
      letter-spacing: 0.055em;

      overflow-wrap: anywhere;
    }


    /* #---
       MOBILE TAGLINE
       Adjusted font sizing
       #--- */

    .hero-content p {
      font-size: clamp(20px, 5vw, 26px);
    }


    /* #---
       MOBILE HERO BUTTON
       Touch friendly spacing
       #--- */

    .hero-button {
      margin-top: 20px;
      padding: 15px 24px;
    }


    /* #---
       MOBILE EXPLORE SECTION
       Reduced spacing for phones
       #--- */

    .explore {
      padding: 65px 20px;
    }


    /* #---
       MOBILE EXPLORE CARDS
       Single column layout
       #--- */

    .explore-grid {
      grid-template-columns: 1fr;
    }

  }

</style>
