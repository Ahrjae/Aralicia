
---
import MainLayout from '../layouts/MainLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const heroImage = `${base}/images/asares-hero.png`;
---

<MainLayout title="Home">

  <section class="hero">

    <div class="hero-visual">
      <div
        class="hero-backdrop"
        style={`background-image: url("${heroImage}")`}
      ></div>

      <img
        class="hero-art"
        src={heroImage}
        alt="Asares wielding iridescent magic"
        width="1484"
        height="1060"
        fetchpriority="high"
      />
    </div>

    <div class="hero-content">
      <span class="eyebrow">
        THE OFFICIAL FANTASY UNIVERSE
      </span>

      <h1>ARALICIA</h1>

      <p>Every story begins somewhere.</p>

      <a class="hero-button" href="#explore">
        EXPLORE ARALICIA
      </a>
    </div>

  </section>

  <section class="explore" id="explore">

    <span class="section-label">
      DISCOVER THE UNIVERSE
    </span>

    <h2>Explore Aralicia</h2>

    <div class="explore-grid">

      <article>
        <h3>The Novel</h3>
        <p>Read chapters, volumes, and story arcs.</p>
      </article>

      <article>
        <h3>Characters</h3>
        <p>Discover Asares, Kaleid, Axel, Thalia, and the cast.</p>
      </article>

      <article>
        <h3>World Guide</h3>
        <p>Explore kingdoms, cultures, creatures, and magic.</p>
      </article>

      <article>
        <h3>Lore Archives</h3>
        <p>Uncover history, legends, and ancient mysteries.</p>
      </article>

      <article>
        <h3>Multimedia</h3>
        <p>Browse illustrations and character artwork.</p>
      </article>

    </div>

  </section>

</MainLayout>

<style>
  .hero {
    position: relative;
    background: #09090d;
    overflow: hidden;
  }

  .hero-visual {
    position: relative;
    width: 100%;
    height: clamp(560px, 60vw, 760px);
    overflow: hidden;
    background: #09090d;
  }

  .hero-backdrop {
    position: absolute;
    inset: -35px;
    background-size: cover;
    background-position: center;
    filter: blur(28px) brightness(0.28);
  }

  .hero-art {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .hero-content {
    position: absolute;
    z-index: 2;
    top: 42%;
    left: 6%;
    transform: translateY(-50%);
    max-width: 700px;
    padding: 28px;
    background: linear-gradient(
      90deg,
      rgba(5, 5, 10, 0.68),
      rgba(5, 5, 10, 0)
    );
  }

  .eyebrow,
  .section-label {
    font-size: 11px;
    letter-spacing: 0.2em;
    font-weight: 800;
    color: #d7baf0;
  }

  h1 {
    font-size: clamp(52px, 7vw, 105px);
    letter-spacing: 0.075em;
    margin: 20px 0 8px;
    color: white;
    line-height: 1.1;
  }

  .hero-content p {
    font-family: Georgia, serif;
    font-size: clamp(22px, 2.7vw, 34px);
    font-style: italic;
    color: #f0eaf5;
  }

  .hero-button {
    display: inline-block;
    margin-top: 30px;
    border: 1px solid #c8b0e5;
    background: rgba(0, 0, 0, 0.5);
    padding: 17px 28px;
    font-size: 12px;
    letter-spacing: 0.08em;
    font-weight: 800;
    color: white;
    text-decoration: none;
  }

  .hero-button:hover {
    background: rgba(170, 145, 210, 0.25);
  }

  .explore {
    max-width: 1200px;
    margin: auto;
    padding: 100px 24px;
  }

  h2 {
    font-family: Georgia, serif;
    font-size: clamp(36px, 5vw, 56px);
    margin: 15px 0 36px;
  }

  .explore-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  article {
    border: 1px solid #36323f;
    background: #141319;
    padding: 30px;
    min-height: 165px;
  }

  article h3 {
    font-size: 21px;
    margin: 0 0 12px;
    color: white;
  }

  article p {
    color: #bcb7c6;
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 700px) {
    .hero-visual {
      height: auto;
      aspect-ratio: 1484 / 1060;
    }

    .hero-backdrop {
      display: none;
    }

    .hero-art {
      width: 100%;
      height: auto;
      object-fit: contain;
    }

    .hero-content {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      max-width: none;
      padding: 35px 24px 48px;
      background: #09090d;
    }

    h1 {
      font-size: clamp(42px, 11vw, 68px);
      letter-spacing: 0.055em;
      overflow-wrap: anywhere;
    }

    .hero-content p {
      font-size: clamp(20px, 5vw, 26px);
    }

    .hero-button {
      margin-top: 20px;
    }

    .explore {
      padding: 65px 20px;
    }

    .explore-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
